rules_version = '2';

// =============================================================================
// Ownership model: every collection has a `user_id` field that must equal the
// signed-in user's uid, and WRITES are owner-only everywhere.
//
// The client-side Leaderboard computes a single overall point per user from
// NON-monetary activity, so it needs cross-user READ access only on:
//   users, study_sessions, habit_logs, daily_checkins
// These hold no financial data. SENSITIVE data stays owner-only:
//   expenses, budgets  (your actual money/amounts are never visible to others)
// `assignments` and `study_sessions` are owned indirectly (via course_id /
// plan_id) — client code must fetch the parent doc to prove ownership before
// reading/writing children in a production app; for now these are read-only
// to any signed-in user and write-restricted to the Cloud Function / admin SDK.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // users/{uid} — doc id IS the uid
    // Read is open to any signed-in user so the client-side Leaderboard can
    // rank everyone (name + identity only). Writes stay owner-only.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // handle account deletion via a Cloud Function
    }

    match /expense_categories/{docId} {
      allow read, write: if signedIn(); // shared reference data
    }

    match /expenses/{docId} {
      allow read, update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /budgets/{docId} {
      allow read, update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /courses/{docId} {
      allow read, update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /course_catalog/{docId} {
      allow read: if signedIn();
      allow write: if signedIn(); // temporary for seeding the catalog
    }

    match /assignments/{docId} {
      allow read: if signedIn();
      allow write: if false; // write via Cloud Function that checks course ownership
    }

    match /study_plans/{docId} {
      allow read, update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /study_sessions/{docId} {
      allow read: if signedIn();
      // Client writes are allowed when the session belongs to a plan the
      // signed-in user owns (checked against the plan's user_id).
      allow create: if signedIn()
        && request.resource.data.plan_id is string
        && get(/databases/$(database)/documents/study_plans/$(request.resource.data.plan_id)).data.user_id == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.plan_id is string
        && get(/databases/$(database)/documents/study_plans/$(resource.data.plan_id)).data.user_id == request.auth.uid;
    }

    match /habit_logs/{docId} {
      // Read open to any signed-in user for the leaderboard habit score
      // (habit_score is a 0-100 rating — no monetary/financial data).
      allow read: if signedIn();
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /stress_predictions/{docId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false; // predictions are immutable once written
    }

    match /ai_chats/{docId} {
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if false; // chat turns are immutable once written
    }

    match /notifications/{docId} {
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      // Clients may only flip is_read — everything else is server-written.
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
      allow create: if false; // notifications are pushed by the backend
    }

    match /daily_checkins/{docId} {
      // Read open to any signed-in user for the leaderboard check-in streak.
      allow read: if signedIn();
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // Unused — the client-side leaderboard computes scores directly and does
    // NOT read this collection. Kept private (no reads from app users).
    match /leaderboard_scores/{uid} {
      allow read: if false;
      allow write: if false;
    }

    match /achievements/{docId} {
      allow read: if signedIn();
      allow write: if false; // seeded by an admin script
    }

    match /user_achievements/{docId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
